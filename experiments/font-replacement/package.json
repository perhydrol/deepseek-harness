{
  "name": "@local/dsh-font-replacement",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HarmonyOS Sans SC text and Maple Mono code and terminal fonts for DSH.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "fonts", "README.md"],
  "scripts": { "test": "node --test tests/assets.test.js" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-ui-theme"]
    }
  }
}
