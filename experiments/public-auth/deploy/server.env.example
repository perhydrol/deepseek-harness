PUBLIC_ORIGIN=https://harness.example.com
# Optional: configure a provider in DSH instead of supplying a key here.
DEEPSEEK_API_KEY=
SESSION_DAYS=30
LOGIN_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=60
# Validated-session cache lifetime in seconds; 0 disables it.
SESSION_CACHE_SECONDS=60
# Exact Nginx socket-peer IPs, comma-separated; empty disables forwarding trust.
TRUSTED_PROXY_IPS=
