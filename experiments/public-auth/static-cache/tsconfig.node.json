{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "tsBuildInfoFile": "dist/.tsbuildinfo-node"
  },
  "include": ["src/index.ts", "src/config.ts", "src/register.ts"]
}
