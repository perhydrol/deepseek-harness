# Host dependencies and generated outputs must not enter the Linux build.
**/node_modules
**/lib
**/dist
**/*.tsbuildinfo
native/system/packages/*/bin
native/system/test/bin
apps/desktop/.desktop-build
.artifacts
.dsh-build
.release
coverage
.cache
.pnpm-store
tmp

# Local state, credentials, certificates and worktrees.
.git
.github
.codex
.claude
.superpowers
.worktrees
worktrees
.agents/worktrees
**/.env
**/.env.*
**/.venv
**/__pycache__
**/*.pyc
**/.storages
**/.sessions
**/*.sqlite
**/*.sqlite-*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa
**/id_ed25519
pnpm-debug.log
**/.dsh
**/.aws
**/.ssh
**/.gnupg
**/.npmrc
**/.git
